# ── 应用 ──
APP_NAME=IntelliKB
APP_VERSION=1.0.1
ENVIRONMENT=development

# ── 数据库 ──
# MYSQL_PASSWORD 必须与 DB_PASSWORD 保持一致（同一 MySQL 用户）
DB_HOST=mysql
DB_PORT=3306
DB_USER=intellikb
DB_PASSWORD=devpass123
DB_NAME=intellikb
MYSQL_ROOT_PASSWORD=rootpass123
MYSQL_PASSWORD=devpass123

# F8: alembic 离线迁移同步 URL（使用 pymysql 而非 aiomysql）
# 不设置则自动从 database_url 转换（+aiomysql → +pymysql）
# ALEMBIC_SYNC_URL=mysql+pymysql://intellikb:devpass123@mysql:3306/intellikb?charset=utf8mb4

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ──
# 生产环境：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE-ME-use-secrets.token_hex(32)-to-generate
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 管理员 ──
# 生产环境：必须设置强密码（不在弱密码黑名单中）
# 开发环境：默认 admin/admin123（仅当 ENVIRONMENT=development）
ADMIN_PASSWORD=

# ── CORS ──
CORS_ORIGINS_DEV=["http://localhost:5173","http://localhost:3000"]
CORS_ORIGINS_PROD=["https://your-domain.com"]

# ── LLM ──
LLM_PROVIDER=ollama
# 本地开发（非 Docker）: http://localhost:11434/v1
# Docker 容器访问宿主机 Ollama: http://host.docker.internal:11434/v1
# 仅在 Ollama 也作为 Docker 服务运行时才使用 http://ollama:11434/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL_NAME=qwen2.5:7b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ── 本地 Ollama 地址（Phase 6 fallback 专用）──
# 这两个配置始终存在，与 LLM_PROVIDER 无关。
# 当 LLM_PROVIDER=deepseek（或其他云端 provider）时，_try_cloud_fallback()
# 使用此地址连接本地 Ollama，确保云端故障时能自动降级。
# 即使主 provider 是 deepseek，也需要正确配置这两个值指向可用的 Ollama 实例。
# Docker 内: http://host.docker.internal:11434/v1，本地开发: http://localhost:11434/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama

# ── Embedding ──
# nomic-embed-text: 768 维通用 Embedding 模型（Ollama 可用）
# bge-m3: 1024 维多语言模型，中文表现更好 (需先 ollama pull bge-m3)
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
# ── Phase 8 P2.2: 多语言 Embedding ──
EMBEDDING_MODEL_ZH=bge-m3
EMBEDDING_MODEL_EN=nomic-embed-text
# 自动检测文档语言并选择对应模型（需额外依赖）
EMBEDDING_AUTO_DETECT_LANG=false

# ── 向量数据库 ──
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIR=/app/chroma_data

# ── 缓存 ──
RAG_CACHE_TTL_SECONDS=3600
RAG_CACHE_ENABLED=true

# ── SSE ──
SSE_TIMEOUT_SECONDS=300
SSE_HEARTBEAT_INTERVAL=15

# ── Phase 2: 混合检索 ──
HYBRID_BM25_TOP_K=20
HYBRID_VECTOR_TOP_K=20
HYBRID_RRF_K=60
HYBRID_RERANK_TOP_K=5

# ── Phase 2: Rerank ──
RERANK_ENABLED=true
# ── Phase 8: 中文 Reranker 升级（三层优先级）──
# Tier 1 (推荐): 中文优化模型，~1.3GB，6GB VRAM 可运行
#   python scripts/download_reranker.py
RERANK_MODEL_ZH=BAAI/bge-reranker-base
# Tier 2 (降级): 英文通用模型，~200MB，CPU 友好
RERANK_MODEL_FALLBACK=cross-encoder/ms-marco-MiniLM-L-6-v2
# Tier 3 (遗留): 通用配置（兼容 Phase 2-7）
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# ── Phase 7: Rerank 离线 ──
# 本地模型缓存目录。离线部署前运行: python scripts/download_reranker.py
# 模型下载到此目录后，断网启动时优先加载本地模型。
# 下载全部三层: python scripts/download_reranker.py --all
RERANK_LOCAL_DIR=./reranker_models

# ── Phase 2: Query Rewrite ──
QUERY_REWRITE_ENABLED=true
# ── Phase 8: 查询重写策略 ──
# A=resolution: 指代消解（默认），B=decomposition: 问题拆解，C=keyword: 关键词提取
QUERY_REWRITE_STRATEGY=A

# ── 文件上传 ──
MAX_UPLOAD_SIZE_MB=50
# ── Phase 8: 语义分块 ──
# fixed: 固定长度分块（向后兼容）
# semantic: 按 Markdown 标题/段落/句子边界切分（推荐）
CHUNKING_STRATEGY=semantic
# ── Phase 10: 资源配额 ──
# 启用后限制 KB 数/文档数/成员数/存储空间
# QUOTA_ENABLED=false
# QUOTA_MAX_KB_PER_USER=10
# QUOTA_MAX_DOCUMENTS_PER_KB=100
# QUOTA_MAX_KB_MEMBERS_PER_KB=20
# QUOTA_MAX_STORAGE_MB_PER_USER=500

# ── Phase 8 P2: OCR 支持 ──
# 启用扫描版 PDF/图片 OCR。需先安装: pip install paddleocr (推荐) 或 pytesseract
# OCR_ENABLED=false
# OCR_ENGINE=paddleocr     # paddleocr | tesseract
# OCR_LANGUAGE=ch           # ch=中英混合

# ── 日志 ──
LOG_LEVEL=INFO

# ── 限流 ──
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=900
REGISTER_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW=3600

# ── Phase 3: Agent ──
# 启用 Agent 对话功能
AGENT_ENABLED=true
# Agent 专用模型（同 RAG 模型）
AGENT_MODEL=qwen2.5:7b
# Agent 超时时间
AGENT_TIMEOUT_SECONDS=120
# 最大工具调用轮次
AGENT_MAX_TOOL_ITERATIONS=5

# ── Phase 3: 对话 ──
# 对话最大历史轮数
CONVERSATION_MAX_HISTORY_ROUNDS=20
# 自动标题截取长度
CONVERSATION_TITLE_LENGTH=30

# ── Phase 3: SSE ──
# 启用 Pub/Sub 进度推送
SSE_PUBSUB_ENABLED=true

# ── Phase 3: 成员缓存 ──
# KBMember 缓存 TTL
MEMBER_CACHE_TTL_SECONDS=60

# ── Phase 6: 云端 LLM (DeepSeek) ──
# 切换到云端模型的步骤：
#   1. 将 LLM_PROVIDER 改为 deepseek
#   2. 设置 CLOUD_API_KEY=sk-你的密钥
#   3. 设置 CLOUD_LLM_CONFIRMED=true 显式确认
#   4. 重启服务
# 切换回本地：LLM_PROVIDER=ollama 即可
# CLOUD_LLM_CONFIRMED=false
# CLOUD_API_KEY=sk-your-deepseek-api-key
# CLOUD_BASE_URL=https://api.deepseek.com/v1
# CLOUD_MODEL_NAME=deepseek-chat
# CLOUD_AGENT_MODEL=deepseek-chat

# ── Phase 6: 成本上限 ──
# 超过限额后 Agent 对话返回 HTTP 429
# DAILY_TOKEN_LIMIT=100000
# MONTHLY_TOKEN_LIMIT=2000000
